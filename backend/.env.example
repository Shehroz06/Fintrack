DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=finance_management
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Optional — enables AI-generated recommendations and smarter transaction
# categorization via Gemini. If unset, the app falls back to the local
# rule-based engine automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
